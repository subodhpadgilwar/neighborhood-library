# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=neighborhood_library
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:your_postgres_password@postgres:5432/neighborhood_library

# App
APP_ENV=development
APP_PORT=8000
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000
# Cookie settings (set COOKIE_SECURE=true in production)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Auth
SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Default Admin
ADMIN_EMAIL=subodh@numinolabs.com
ADMIN_PASSWORD=NuminoLabs@2026
ADMIN_FULL_NAME=Subodh Padgilwar
SEED_SAMPLE_DATA=false

# Timezone
APP_TIMEZONE=Asia/Kolkata

# Logging
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
